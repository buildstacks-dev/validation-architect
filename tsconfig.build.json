{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "rootDir": "src",
    "outDir": "dist"
  },
  // The published build is the dependency closure of the provider-neutral API
  // and CLIs plus the single provider-bound design composition. Tests remain
  // outside the emitted tree; package smoke verifies the exact closure.
  "include": [
    "src/api/index.ts",
    "src/catalog.ts",
    "src/trace.ts",
    "src/trace-cli.ts",
    "src/core-cli.ts",
    "src/cli-local-repository.ts",
    "src/design/index.ts",
    "src/design/cli.ts"
  ],
  "exclude": ["test/**", "fixtures/**", "runs/**"]
}
