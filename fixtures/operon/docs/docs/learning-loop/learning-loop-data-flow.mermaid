---
title: Operon Learning Loop - Data Flow (v0.8)
---
flowchart TD
    subgraph EXEC["Execution plane"]
        CTX["Resolved context (pinned per turn,<br/>lineage sticky per episode)"] --> AGENT["Agent turn (app + role)"]
        AGENT -->|"advisory self-reports"| EVENTS
        VERIFIERS["Gates, runlogs, approvals, scorecards,<br/>humans, resolver, publisher"] -->|"metric-bearing events"| EVENTS
    end

    EVENTS["Runtime learning event store<br/>~/.operon/&lt;org&gt;/learning/events"]

    EVENTS --> EPISODES["EpisodeRecord projections<br/>~/.operon/&lt;org&gt;/learning/episodes<br/>(projection over ticket state machine,<br/>runlogs, telemetry, approvals)"]
    EPISODES --> CAPSULES["ReplayCapsules (build episodes, V1)<br/>~/.operon/&lt;org&gt;/learning/capsules"]
    HUMANOBS["Human observations<br/>operon learn emit --episode"] --> EVENTS

    EVENTS -->|"deterministic precheck, then window"| CLUSTER["Cluster by error_class + cause_hypothesis (M6)"]
    LEDGER["Rejection ledger"] -->|"suppression fingerprints"| CLUSTER
    CLUSTER --> ROUTER["Destination router (M6)"]

    ROUTER --> CANDS["learning/candidates/ (never resolvable)"]
    CANDS --> REVIEW["Reviewer (cross-provider role)"]
    REVIEW -->|"activation / T2-T3 / ratified surface"| APPROVAL["Human approval (content-bound,<br/>existing approvals store)"]
    REVIEW -->|"routine: ticket, unmerged draft"| PUBLISHER
    APPROVAL --> PUBLISHER["Deterministic publisher<br/>(sole writer of protected paths;<br/>atomic, idempotent, journaled)"]
    REVIEW -->|"rejected"| LEDGER

    CAPSULES --> RUNNER["ExperimentRunner:<br/>paired control/treatment replay"]
    EXPERIMENTS["learning/experiments/<br/>ExperimentRecords + EvalResults"] <--> RUNNER

    subgraph ORG["Committed org home (operon org init)"]
        ORGMAN["learning/manifest.yaml"]
        ORGBUNDLE["learning/bundle/org + roles (active only)"]
        ORGQUAR["learning/quarantine/ (TTL-bound)"]
        ORGEVALS["learning/evals/roles"]
        INTERV["learning/interventions/<br/>InterventionRecords (all destinations)"]
    end

    subgraph APP["Current app repo"]
        APPMAN[".operon/learning/manifest.yaml"]
        APPBUNDLE[".operon/learning/bundle/apps + app roles"]
        APPEVALS[".operon/learning/evals/apps (not built: fixtures live in the org home learning/evals)"]
    end

    PUBLISHER -->|"approved OKF org/role"| ORGBUNDLE
    PUBLISHER -->|"approved OKF app/app-role"| APPBUNDLE
    PUBLISHER -->|"skill/protocol/eval/gate drafts"| PROPOSALS["Proposal PRs or implementation tickets"]
    PUBLISHER -->|"ticket (deduped, rate-capped)"| ISSUES["Operon issue loop"]
    PUBLISHER --> INTERV

    ORGMAN --> RESOLVER
    APPMAN --> RESOLVER
    ORGBUNDLE --> RESOLVER
    APPBUNDLE --> RESOLVER
    ORGQUAR -->|"unexpired only; UNVERIFIED label"| RESOLVER
    RESOLVER["Resolver: conflicts first, then scope shares<br/>org -> role -> app -> app-role<br/>lineage = hash(episode_id)"] --> CTX
    RESOLVER -->|"concept_loaded, context_evicted,<br/>conflict_resolved, provisional_expired"| EVENTS

    EVENTS -->|"trusted emitters only"| METRICS["JSONL metric projections"]
    EPISODES -->|"outcomes by bundle lineage"| METRICS
    EXPERIMENTS --> METRICS
    ORGEVALS --> METRICS
    APPEVALS --> METRICS
    METRICS --> REPORTS["Canary/experiment report, compaction report,<br/>bundle health, cost per accepted improvement"]
    REPORTS -->|"human promote / rollback / disable in V1"| ORGMAN
    REPORTS -->|"human promote / rollback / disable in V1"| APPMAN
