---
title: Operon Learning Loop - Control Flow (v0.8)
---
flowchart TD
    EVENTS["Trusted and advisory learning events<br/>(every event carries episode_id)"] --> ROUTE

    subgraph DAILY["Distillation cycle (M6) (deterministic precheck first; no evidence = no model turn)"]
        ROUTE["Classify event clusters"] --> CAND["Candidate artifact (candidates/, never resolvable)"]
        CAND --> DEST{"Destination"}
        DEST -->|"scoped fact or lesson"| OKF["OKF concept candidate"]
        DEST -->|"repeatable procedure"| SKILL["Skill draft"]
        DEST -->|"broad behavior rule"| PROTO["Protocol proposal"]
        DEST -->|"mechanically checkable weakness"| EVAL["Eval or gate proposal"]
        DEST -->|"runtime/product work"| TICKET["Operon ticket"]
        DEST -->|"wrong or unsafe"| LEDGER["Rejection ledger"]

        OKF --> REVIEW{"Reviewer verdict (cross-provider)"}
        SKILL --> REVIEW
        PROTO --> REVIEW
        EVAL --> REVIEW
        TICKET --> REVIEW

        REVIEW -->|"reject"| LEDGER
        REVIEW -->|"revise"| ROUTE
    end

    REVIEW -->|"routine: ticket / unmerged proposal draft"| ROUTINE["Publish without human gate<br/>(deduped + rate-capped)"]
    REVIEW -->|"activation, T2/T3, ratified surface"| HUMAN["Human approval via operon approvals<br/>(binds candidate + verdict + diff hashes)"]

    HUMAN -->|"claims efficacy or T2/T3"| EXP["Declared ExperimentRecord required<br/>(or explicit human waiver)"]
    EXP --> PUBLISH
    HUMAN -->|"T0/T1 fact, no efficacy claim"| PUBLISH["Deterministic publisher:<br/>one atomic content-bound transaction<br/>+ InterventionRecord"]
    ROUTINE --> PUBLISH
    HUMAN -->|"reject"| LEDGER

    PUBLISH -->|"active OKF"| CUT["Version cut"]

    REVIEW_OUTAGE["Reviewer unavailable"] -.->|"fail closed: queue + SLA report"| REVIEW

    subgraph URGENT["Urgent lane"]
        PROV["Human-authored provisional OKF<br/>(quarantine/, TTL <= 14d, UNVERIFIED)"] --> HUMAN
        PROV -.->|"TTL expiry enforced by resolver"| ARCHIVE["provisional_expired event; never silently promote"]
    end

    subgraph EVALLOOP["Evaluation funnel (efficacy-claiming candidates)"]
        DET["Fast deterministic checks"] --> TARGETED["Targeted role-level behavioral eval"]
        TARGETED --> REPLAY["Paired offline replay from ReplayCapsule<br/>(stable vs candidate; build episodes in V1)"]
        REPLAY -->|"improved + guardrails pass"| CANARY_OK["Eligible for human-started canary"]
        REPLAY -->|"regressed / inconclusive"| VERDICT_BAD["Reject, extend, or revise"]
    end

    subgraph PROMO["Episode-sticky canary and reports"]
        CUT --> RESOLVE["Resolver: lineage = hash(episode_id)<br/>same bundle for every turn in the episode<br/>(T3 live canary forbidden)"]
        CANARY_OK --> RESOLVE
        RESOLVE --> REPORT{"Report recommendation"}
        REPORT -->|"promote (claim: validated when experiment completed)"| STABLE["Human bumps stable pointer in V1"]
        REPORT -->|"extend"| RESOLVE
        REPORT -->|"revert"| ROLLBACK["Human rollback + follow-up ticket"]
    end

    subgraph CONTAIN["Containment"]
        DISABLE["operon learn disable concept-id"] --> RECUT["New version without concept"]
        VERSION_ROLLBACK["operon learn rollback --root org|app"] --> PTR["Pointer revert"]
    end

    STABLE -.->|"affects only newly resolved episodes (per-turn pin)"| EVENTS
    RECUT -.-> STABLE
    PTR -.-> STABLE
