{
  "name": "@cormidia/validation-architect",
  "version": "0.5.0",
  "private": false,
  "description": "Checked validation compiler and bounded Claude/Codex campaign engine with deterministic and live CLIs.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cormidia/validation-architect.git"
  },
  "homepage": "https://github.com/cormidia/cormidia-web",
  "bugs": {
    "url": "https://github.com/cormidia/validation-architect/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.10.0",
  "bin": {
    "validation-architect": "./bin/validation-architect.js",
    "validation-trace": "./bin/validation-trace.js",
    "validation-architect-design": "./bin/validation-architect-design.js"
  },
  "exports": {
    ".": {
      "types": "./dist/api/index.d.ts",
      "default": "./dist/api/index.js"
    },
    "./design": {
      "types": "./dist/design/index.d.ts",
      "default": "./dist/design/index.js"
    },
    "./schemas/*.schema.json": "./schemas/*.schema.json",
    "./package.json": "./package.json"
  },
  "files": [
    "LICENSE",
    "NOTICE",
    "README.md",
    "THIRD-PARTY-NOTICES.md",
    "bin/*",
    "dist/**",
    "src/**",
    "schemas/**",
    "enablement/**",
    "skill/**",
    "fixtures/**"
  ],
  "scripts": {
    "trace": "tsx src/trace-cli.ts",
    "build": "node scripts/clean-dist.mjs && tsc -p tsconfig.build.json",
    "prepack": "pnpm run build",
    "typecheck": "tsc --noEmit && pnpm run build",
    "test": "vitest run",
    "test:package": "node scripts/package-smoke.mjs",
    "test:watch": "vitest"
  },
  "dependencies": {
    "yaml": "^2.8.0"
  },
  "peerDependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.220",
    "@openai/codex-sdk": "0.146.0"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/claude-agent-sdk": {
      "optional": true
    },
    "@openai/codex-sdk": {
      "optional": true
    }
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.220",
    "@openai/codex-sdk": "0.146.0",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
