{
  "name": "validation-architect",
  "version": "0.4.5",
  "private": false,
  "description": "Provider-neutral validation architecture: deterministic contracts, campaign orchestration, schemas, skills, and CLI.",
  "license": "LicenseRef-FSL-1.1-MIT",
  "licenseFile": "LICENSE.md",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cormidia/validation-architect.git"
  },
  "homepage": "https://github.com/cormidia/validation-architect#readme",
  "bugs": {
    "url": "https://github.com/cormidia/validation-architect/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.10.0",
  "bin": {
    "validation-architect": "./bin/validation-architect.js",
    "validation-trace": "./bin/validation-trace.js"
  },
  "exports": {
    ".": {
      "types": "./dist/api/index.d.ts",
      "default": "./dist/api/index.js"
    },
    "./schemas/*.schema.json": "./schemas/*.schema.json",
    "./package.json": "./package.json"
  },
  "files": [
    "LICENSE.md",
    "THIRD-PARTY-NOTICES.md",
    "bin/validation-architect.js",
    "bin/validation-trace.js",
    "dist/**",
    "schemas/**",
    "enablement/**",
    "skill/validation-harness-design/**",
    "skill/validation-harness-audit/**",
    "skill/implement-harness-ticket/**"
  ],
  "scripts": {
    "vda": "tsx src/cli.ts",
    "trace": "tsx src/trace-cli.ts",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "pnpm run build",
    "typecheck": "tsc --noEmit && pnpm run build && tsc -p design/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:package": "node scripts/package-smoke.mjs",
    "test:watch": "vitest"
  },
  "dependencies": {
    "yaml": "^2.8.0"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.220",
    "@openai/codex-sdk": "0.146.0",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
