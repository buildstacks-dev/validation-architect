{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "validation-architect/design-run/v1",
  "title": "Validation Architect design run",
  "description": "Campaign envelope and resumable checkpoint. The envelope is admitted by the host before the first turn and never enlarged by the library; the checkpoint is a compare-and-swap record whose pending idempotency key closes the crash window between a provider result and the next save.",
  "oneOf": [
    {
      "type": "object",
      "required": ["schema", "kind", "profile", "packageVersion", "sourceRevision", "inputIdentity", "shape", "seats", "states", "transitions", "terminals", "outputSchemas", "limits"],
      "properties": {
        "schema": { "const": "validation-architect/design-run/v1" },
        "kind": { "const": "envelope" },
        "profile": { "enum": ["C0", "C1", "C2", "C3", "C4"] },
        "shape": { "enum": ["sequence", "graph"] },
        "seats": { "type": "array" },
        "states": { "type": "array", "items": { "type": "string" } },
        "transitions": { "type": "array", "items": { "type": "object", "required": ["from", "to", "seat", "turnCost"] } },
        "terminals": { "type": "array", "items": { "type": "string" } },
        "outputSchemas": { "type": "object" },
        "limits": {
          "type": "object",
          "required": ["maxTurns", "maxWallMs", "maxTokensPerTurn", "maxArtifactFiles", "maxArtifactBytes", "maxHistoryBytes", "maxPromptBytes", "maxIntakeBytes"],
          "properties": {
            "maxTurns": { "type": "integer", "minimum": 1 },
            "maxWallMs": { "type": "integer", "minimum": 1 },
            "maxTokensPerTurn": { "type": "integer", "minimum": 1 },
            "maxArtifactFiles": { "type": "integer", "minimum": 1 },
            "maxArtifactBytes": { "type": "integer", "minimum": 1 },
            "maxHistoryBytes": { "type": "integer", "minimum": 1 },
            "maxPromptBytes": { "type": "integer", "minimum": 1 },
            "maxIntakeBytes": { "type": "integer", "minimum": 1 },
            "maxRelayExchanges": { "type": "integer", "minimum": 1 },
            "maxReaderTurns": { "type": "integer", "minimum": 1 },
            "maxAuditIterations": { "type": "integer", "minimum": 1 },
            "maxStakeholderExchangesPerAuditWindow": { "type": "integer", "minimum": 1 }
          }
        }
      }
    },
    {
      "type": "object",
      "required": ["schema", "kind", "runId", "generation", "packageVersion", "sourceRevision", "envelope", "position", "receipts", "sessions", "artifacts", "intake", "mode", "repository", "startedAtEpochMs", "usage"],
      "properties": {
        "schema": { "const": "validation-architect/design-run/v1" },
        "kind": { "const": "checkpoint" },
        "generation": { "type": "integer", "minimum": 0 },
        "pendingTurn": {
          "type": "object",
          "required": ["idempotencyKey", "request", "createdAtEpochMs"],
          "properties": {
            "createdAtEpochMs": { "type": "integer", "minimum": 1 }
          }
        },
        "receipts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["idempotencyKey", "seat", "state", "nextState", "status"],
            "properties": {
              "status": { "enum": ["ok", "refused", "limit_exhausted", "error"] },
              "accepted": { "type": "boolean" },
              "artifactChanges": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["path", "sha256"],
                  "properties": {
                    "path": { "type": "string", "minLength": 1 },
                    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
                  }
                }
              }
            }
          }
        },
        "sessions": { "type": "object" },
        "artifacts": { "type": "object" },
        "intake": { "type": "string" },
        "mode": { "enum": ["greenfield", "revision"] },
        "repository": {
          "type": "object",
          "required": ["revision", "identity", "inventory", "files"],
          "properties": {
            "revision": { "type": "string", "minLength": 1 },
            "identity": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            "inventory": { "type": "array", "items": { "type": "string" } },
            "files": { "type": "array" }
          }
        },
        "startedAtEpochMs": { "type": "integer", "minimum": 1 },
        "auditCoreIdentity": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "usage": { "type": "object", "required": ["turns", "inputTokens", "outputTokens"] }
      }
    }
  ]
}
