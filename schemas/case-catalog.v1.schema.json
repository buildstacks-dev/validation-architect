{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "validation-architect/case-catalog/v1",
  "title": "Validation Architect case-catalog manifest",
  "description": "The generated catalog manifest joining case families, tickets, and conventions. parseManifest/serializeManifest in the package are the runtime authority.",
  "type": "object",
  "required": ["schema", "product", "conventions", "families", "tickets"],
  "properties": {
    "schema": { "const": "validation-architect/case-catalog/v1" },
    "product": { "type": "string", "minLength": 1 },
    "conventions": {
      "type": "object",
      "required": ["tests_root"],
      "properties": { "tests_root": { "type": "string", "minLength": 1 } }
    },
    "families": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "section", "layers", "oracle", "risk", "status"],
        "properties": {
          "id": { "type": "string", "pattern": "^CF-" },
          "status": { "enum": ["implementable", "pruned", "blocked"] },
          "evidence_state": { "enum": ["complete", "incomplete", "inconclusive", "unobserved"] }
        }
      }
    },
    "tickets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "status"],
        "properties": { "status": { "enum": ["pending", "landed", "blocked", "parked"] } }
      }
    }
  }
}
