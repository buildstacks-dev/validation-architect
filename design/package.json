{
  "name": "validation-architect-design",
  "version": "0.1.1",
  "private": false,
  "description": "Provider-bound local composition for validation-architect design campaigns: read-only fs/git repository adapter, atomic file-backed campaign store, one concrete TurnPort over the Claude Agent SDK and Codex SDK, and the validation-architect-design CLI.",
  "license": "LicenseRef-FSL-1.1-MIT",
  "licenseFile": "LICENSE.md",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "validation-architect-design": "./bin/validation-architect-design.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "LICENSE.md",
    "bin/validation-architect-design.js",
    "dist/**"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "pnpm run build",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "validation-architect": "workspace:*",
    "@anthropic-ai/claude-agent-sdk": "0.3.220",
    "@openai/codex-sdk": "0.146.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
